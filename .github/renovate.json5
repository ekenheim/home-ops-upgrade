{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  rebaseWhen: 'behind-base-branch',
  // Flag dependencies whose upstream has stopped releasing (on the Dependency
  // Dashboard). Renovate can't update an image nobody publishes any more
  // (k8s-at-home/xteve, onedr0p/kubanetics, Grafana's old chart repo), and
  // those were the stalest, most vulnerable images Trivy found on 2026-10-18.
  abandonmentThreshold: '6 months',
  // No hostRules here. The self-hosted job (renovate-operator) supplies the
  // ghcr.io credential for the private ghcr.io/ekenheim/* images from its env:
  // see kubernetes/apps/kube-tools/renovate-operator/jobs/home-ops.yaml.
  extends: [
    ':skipStatusChecks',
    'helpers:pinGitHubActionDigests',
    'github>ekenheim/renovate-config',
    'github>ekenheim/renovate-config:autoMerge',
    'github>ekenheim/home-ops-upgrade//.github/renovate/autoMergeDocker.json5',
    'github>ekenheim/home-ops-upgrade//.github/renovate/autoMergeApps.json5',
    'github>ekenheim/home-ops-upgrade//.github/renovate/customManagers.json5',
    'github>ekenheim/home-ops-upgrade//.github/renovate/grafanaDashboards.json5',
    'github>ekenheim/home-ops-upgrade//.github/renovate/groups.json5',
    'github>ekenheim/home-ops-upgrade//.github/renovate/packageRules.json5',
  ],
  ignorePaths: [
    '**/*.sops.*',
    '**/resources/**',
  ],
  flux: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/(^|/)\\.taskfiles/.+\\.ya?ml$/',
      '/(^|/)ansible/.+\\.ya?ml(?:\\.j2)?$/',
      '/(^|/)kubernetes/.+\\.ya?ml$/',
    ],
  },
}
