{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  packageRules: [
    {
      description: 'Auto-merge application patch/minor updates after CI passes',
      matchDatasources: ['docker', 'helm', 'github-releases'],
      matchUpdateTypes: ['minor', 'patch'],
      matchFileNames: [
        'kubernetes/apps/**',
      ],
      automerge: true,
      automergeType: 'pr',
      automergeStrategy: 'squash',
      platformAutomerge: true,
      ignoreTests: false,
    },
    {
      description: 'Auto-merge terraform provider patch/minor updates (publish-only workflow, no auto-apply)',
      matchManagers: ['terraform'],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
      automergeType: 'pr',
      automergeStrategy: 'squash',
      platformAutomerge: true,
      ignoreTests: false,
    },
    {
      // Release Soak holds these for three days and needs a clean AI review of
      // the commit before it passes, so a major with findings waits for a
      // person. Stays above the list below, which keeps infrastructure manual.
      description: 'Auto-merge majors that pass Release Soak',
      matchDatasources: ['docker', 'helm', 'github-releases'],
      matchUpdateTypes: ['major'],
      matchFileNames: [
        'kubernetes/apps/**',
      ],
      automerge: true,
      automergeType: 'pr',
      automergeStrategy: 'squash',
      platformAutomerge: true,
      ignoreTests: false,
    },
    {
      description: 'Never auto-merge infrastructure, networking, storage, or hardware-sensitive components',
      matchPackageNames: [
        // CNI / networking / DNS
        '/cilium/',
        '/coredns/',
        // Storage layer
        '/rook.ceph/',
        '/rook-ceph/',
        // OpenEBS Local PV Hostpath backs the Crunchy pgdata volumes and the
        // VolSync caches. Its chart moved off a dead mirror on 2026-10-19.
        '/openebs/',
        // Hardware / device plugins
        '/intel-device-plugins-operator/',
        '/intel-device-plugins-gpu/',
        // Talos OS / bootloader / installer
        '/siderolabs/talosctl/',
        '/siderolabs/installer/',
        // GitOps and cluster-critical controllers
        '/flux-operator/',
        '/flux-instance/',
        '/cert-manager/',
        '/external-secrets/',
        '/spegel/',
        '/system-upgrade-controller/',
        '/dragonfly/',
        // Actions Runner Controller (self-hosted runners)
        '/gha-runner-scale-set-controller/',
        '/gha-runner-scale-set/',
        // Istio service mesh
        '/istio/',
      ],
      automerge: false,
    },
    {
      // Our own image, released from ekenheim/marketing-agency.
      description: 'Auto-merge every marketing-agency website release after CI passes',
      matchDatasources: ['docker'],
      matchPackageNames: ['ghcr.io/ekenheim/marketing-agency-website'],
      matchUpdateTypes: ['major', 'minor', 'patch', 'digest'],
      automerge: true,
      automergeType: 'pr',
      automergeStrategy: 'squash',
      platformAutomerge: true,
      ignoreTests: false,
    },
  ],
}
