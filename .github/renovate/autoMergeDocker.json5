{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      // A digest bump is the same tag rebuilt, and on a rolling tag it is
      // the only update there is. Merging them by hand does not scale
      // (amd-strix-halo-toolboxes alone rebuilds about four times a day), so
      // every image gets them merged automatically, once a week, off-hours:
      // each merge restarts the workload and may pull a multi-GB image.
      // pinDigest is the first pin that packageRules.json5 asks for.
      // This rule is first on purpose. The rules below repeat
      // `schedule: at any time` for images that must deploy immediately.
      // A PR, not branch automerge: main's required checks only run on PRs, so
      // an automerge branch waits for them forever, and Release Soak needs a
      // PR to hold.
      "description": ["Auto-merge all container digest updates, weekly"],
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "schedule": ["* 0-5 * * 1"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "platformAutomerge": true,
      "ignoreTests": false
    },
    {
      "description": ["Auto-merge container digests updates"],
      "schedule": ["at any time"],
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "platformAutomerge": true,
      "matchUpdateTypes": ["digest"],
      "matchPackageNames": ["/bjw-s/", "/bjw-s-labs/", "/home-operations/", "/joryirving/", "buroa", "/ekenheim/"],
      "ignoreTests": false
    },
    {
      "description": "Auto-merge OCI Charts",
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/kube-prometheus-stack/", "prefect", "reloader", "windmill", "/actions-runner-controller/", "/toolhive/"],
      "ignoreTests": false
    },
    {
      "description": "Auto-merge GitHub Releases",
      "matchDatasources": ["github-releases"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/gateway-api/", "/prometheus-operator/"],
      "ignoreTests": false
    },
    {
      "description": ["Auto-merge container updates for hugo blog"],
      "schedule": ["at any time"],
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "branch",
      "matchUpdateTypes": ["major", "minor", "patch", "digest"],
      "matchPackageNames": ["ghcr.io/ekenheim/agency", "ghcr.io/ekenheim/bloghugo"]
    },
    {
      "description": ["Auto-merge hempriser/nordic-housing image updates"],
      "schedule": ["at any time"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/nordic-housing/"],
      "matchUpdateTypes": ["major", "minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    }
  ]
}