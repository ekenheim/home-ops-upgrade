{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": ["Auto-merge container digests updates"],
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "branch",
      "matchUpdateTypes": ["digest"],
      "matchPackageNames": ["/bjw-s/", "/bjw-s-labs/", "/home-operations/", "/joryirving/", "buroa", "/ekenheim/"],
      "ignoreTests": true
    },
    {
      "description": "Auto-merge OCI Charts",
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/kube-prometheus-stack/", "prefect", "reloader", "windmill", "/actions-runner-controller/", "/toolhive/"],
      "ignoreTests": false
    },
    {
      "description": "Auto-merge GitHub Releases",
      "matchDatasources": ["github-releases"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/gateway-api/", "/prometheus-operator/"],
      "ignoreTests": false
    },
    {
      "description": ["Auto-merge container updates for hugo blog"],
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "branch",
      "matchUpdateTypes": ["major", "minor", "patch", "digest"],
      "matchPackageNames": ["ghcr.io/ekenheim/agency", "ghcr.io/ekenheim/bloghugo"]
    },
    {
      "description": ["Auto-merge hempriser/nordic-housing image updates"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/nordic-housing/"],
      "matchUpdateTypes": ["major", "minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      // Upstream publishes ~4 rebuilds a day. Without the schedule each one
      // would restart whisper (strategy Recreate) and pull a multi-GB image
      // onto worker4; weekly keeps it current without the churn.
      "description": ["Auto-merge amd-strix-halo-toolboxes timestamped rebuilds, weekly"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/kyuz0/amd-strix-halo-toolboxes"],
      "matchCurrentValue": "/_\\d{8}T\\d{6}$/",
      "matchUpdateTypes": ["major", "minor", "patch"],
      "schedule": ["* 0-5 * * 1"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    }
  ]
}
