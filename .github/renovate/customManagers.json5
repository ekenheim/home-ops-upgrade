{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": ["Process annotated dependencies"],
      "fileMatch": [
        "(^|/).+\\.env$",
        "(^|/).+\\.sh$",
        "(^|/)Dockerfile$",
        "(^|/).+\\.ya?ml(?:\\.j2)?$"
      ],
      "matchStrings": [
        // # renovate: datasource=github-releases depName=k3s-io/k3s
        // k3s_release_version: &version v1.29.0+k3s1
        // # renovate: datasource=helm depName=cilium repository=https://helm.cilium.io
        // version: 1.15.1
        // # renovate: datasource=docker depName=ghcr.io/siderolabs/kubelet
        // KUBERNETES_VERSION=v1.31.1
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
        // # renovate: datasource=docker depName=ghcr.io/prometheus-operator/prometheus-operator
        // https://raw.githubusercontent.com/prometheus-operator/prometheus-operator/v0.80.0/example/prometheus-operator-crd/monitoring.coreos.com_alertmanagerconfigs.yaml
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+/(?<currentValue>(v|\\d)[^/]+)",
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\n.+?\"(?<currentValue>\\S+)\""
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}"
    },
    {
      // agent-factory passes its sandbox images to the orchestrator as env
      // values, which the kubernetes manager does not read (it only reads
      // `image:`). A `# renovate:` annotation would not do either: the
      // manager above would take the whole ref as currentValue. This one
      // splits it, so tag and digest move together with the CronJob image
      // (groups.json5 puts all four in one PR):
      // value: ghcr.io/ekenheim/agent-factory-base:v0.2.0@sha256:<64 hex>
      "customType": "regex",
      "description": ["agent-factory sandbox images in the orchestrator's env"],
      "fileMatch": ["(^|/)kubernetes/apps/agent-lab/.+\\.ya?ml$"],
      "matchStrings": [
        "value:\\s*[\"']?(?<depName>ghcr\\.io/ekenheim/agent-factory-[a-z]+):(?<currentValue>[^\\s@\"']+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": ["Bump README shields.io static badges annotated with renovate comments"],
      "fileMatch": ["(^|/)README\\.md$"],
      "matchStrings": [
        // <!-- renovate: datasource=github-releases depName=fluxcd/flux2 -->
        // [![Flux](https://img.shields.io/badge/Flux-v2.8.6-blue?...)](...)
        "<!-- renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) -->\\s*\\n.*?-(?<currentValue>v\\d+\\.\\d+\\.\\d+)-"
      ]
    }
  ]
}