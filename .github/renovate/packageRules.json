{"$schema":"https://docs.renovatebot.com/renovate-schema.json","packageRules":[{"description":["No major updates for Postgres sidecars with on-disk data"],"matchDatasources":["docker"],"matchPackageNames":["docker.io/library/postgres","docker.io/postgis/postgis"],"matchFileNames":["kubernetes/apps/media/dispatcharr/**","kubernetes/apps/default/dawarich/**"],"matchUpdateTypes":["major"],"enabled":false},{"description":["Semver versioning for nordic-housing images"],"matchDatasources":["docker"],"matchPackageNames":["/ghcr.io\\/ekenheim\\/nordic-housing/"],"versioning":"semver"},{"description":["Loose versioning for non-semver packages"],"matchDatasources":["docker"],"versioning":"loose","matchPackageNames":["/plex/"]},{"description":["Build-number versioning and a monthly cadence for llama.cpp server images"],"matchDatasources":["docker"],"matchPackageNames":["ghcr.io/ggml-org/llama.cpp"],"versioning":"regex:^server-b(?<major>\\d+)$","schedule":["on the first day of the month"]},{"description":["Custom versioning for mylar3"],"matchDatasources":["docker"],"versioning":"regex:^version-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$","matchPackageNames":["/mylar3/"]},{"description":["Process terraform files"],"matchManagers":["terraform"],"matchDatasources":["terraform-provider"],"versioning":"terraform","matchPackagePatterns":[".*"]},{"description":["Version-only updates for images with mutable release tags"],"matchDatasources":["docker"],"matchPackageNames":["ghcr.io/misospace/llmkube-coder","ghcr.io/fscorrupt/posterizarr","ghcr.io/linuxserver/mariadb","docker.io/library/python"],"matchUpdateTypes":["digest"],"enabled":false},{"description":["Date-plus-sha versioning and a monthly cadence for searxng rolling tags"],"matchDatasources":["docker"],"matchPackageNames":["ghcr.io/searxng/searxng"],"versioning":"regex:^(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,2})-(?<build>[0-9a-f]+)$","schedule":["on the first day of the month"]},{"description":["Date-based versioning for MinIO RELEASE.* tags"],"matchDatasources":["docker"],"matchPackageNames":["quay.io/minio/minio","docker.io/pgsty/silo"],"versioning":"regex:^RELEASE\\.(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})T(?<build>[\\d-]+)Z$"},{"description":["Semver versioning behind umami's postgresql- tag prefix"],"matchDatasources":["docker"],"matchPackageNames":["ghcr.io/umami-software/umami"],"versioning":"regex:^postgresql-v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"},{"description":["ROCm versioning for amd-strix-halo-toolboxes"],"matchDatasources":["docker"],"matchPackageNames":["docker.io/kyuz0/amd-strix-halo-toolboxes"],"versioning":"regex:^rocm-(?<major>\\d+)\\.(?<minor>\\d+)(\\.(?<patch>\\d+))?$"},{"description":["Prefix-aware versioning for text-embeddings-inference CPU tags"],"matchDatasources":["docker"],"matchPackageNames":["ghcr.io/huggingface/text-embeddings-inference"],"versioning":"regex:^cpu-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"},{"description":["Date-plus-sha versioning for it-tools"],"matchDatasources":["docker"],"matchPackageNames":["ghcr.io/corentinth/it-tools"],"versioning":"regex:^(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,2})-(?<build>[0-9a-f]+)$"},{"description":["PG-major + PostGIS versioning for postgis images, never automerged"],"matchDatasources":["docker"],"matchPackageNames":["docker.io/postgis/postgis"],"versioning":"regex:^(?<major>\\d+)-(?<minor>\\d+)\\.(?<patch>\\d+)(?<compatibility>-alpine)?$","automerge":false},{"description":["Hold postgis on 3.5 until 3.6 ships an upgrade path from 3.5.7"],"matchDatasources":["docker"],"matchPackageNames":["docker.io/postgis/postgis"],"matchFileNames":["kubernetes/apps/default/dawarich/**"],"allowedVersions":"/^17-3.5(-alpine)?$/"},{"description":["gpu-jupyter release versioning, never automerged"],"matchDatasources":["docker"],"matchPackageNames":["cschranz/gpu-jupyter","docker.io/cschranz/gpu-jupyter"],"versioning":"regex:^v(?<major>\\d+)\\.(?<minor>\\d+)_cuda-(?<patch>\\d+)\\.(?<build>\\d+)_ubuntu-[\\d.]+_python-only$","automerge":false},{"description":["PEP 440 versioning for langflow images, never automerged"],"matchDatasources":["docker"],"matchPackageNames":["langflowai/langflow","docker.io/langflowai/langflow"],"versioning":"pep440","automerge":false},{"description":["Pin kubelet/kubectl to <1.36 (awaiting Talos 1.13 GA)"],"matchDatasources":["docker"],"matchPackageNames":["ghcr.io/siderolabs/kubelet","registry.k8s.io/kubectl","docker.io/alpine/kubectl"],"allowedVersions":"<1.36.0"},{"description":["Hold llmkube chart below 0.9.28 until the InferenceServices carry their own spec.args"],"matchDatasources":["docker"],"matchPackageNames":["ghcr.io/defilantech/charts/llmkube"],"allowedVersions":"<0.9.28"},{"description":["Never propose hermes-agent's retired CalVer tags (v2026.x); never automerge it"],"matchDatasources":["docker"],"matchPackageNames":["docker.io/nousresearch/hermes-agent"],"allowedVersions":"!/^v?\\d{4}\\./","automerge":false},{"description":["Pin digests on rolling tags so they update through Renovate"],"matchDatasources":["docker"],"matchCurrentValue":"/^([a-z][a-z0-9_-]*|\\d+(-[a-z0-9_-]+)?)$/","matchPackageNames":["!/ekenheim/","!/nordic-housing/"],"pinDigests":true},{"description":["Pin digests on amd-strix-halo-toolboxes ROCm tags"],"matchDatasources":["docker"],"matchPackageNames":["docker.io/kyuz0/amd-strix-halo-toolboxes"],"pinDigests":true},{"description":["Do not pin digests on devcontainer features"],"matchManagers":["devcontainer"],"matchDepTypes":["feature"],"pinDigests":false},{"description":["Never automerge Kavita (one-way DB migrations)"],"matchDatasources":["docker"],"matchPackageNames":["ghcr.io/kareadita/kavita"],"automerge":false},{"description":["Never automerge anything under kubernetes/apps/development/atlas (Atlas)"],"matchFileNames":["kubernetes/apps/development/atlas/**"],"automerge":false},{"description":["Never automerge ghcr.io/ekenheim/atlas"],"matchDatasources":["docker"],"matchPackageNames":["ghcr.io/ekenheim/atlas"],"automerge":false}]}