{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": ["Semver versioning for nordic-housing images"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/ghcr.io\\/ekenheim\\/nordic-housing/"],
      "versioning": "semver"
    },
    {
      "description": ["Loose versioning for non-semver packages"],
      "matchDatasources": ["docker"],
      "versioning": "loose",
      "matchPackageNames": ["/plex/"]
    },
    {
      "description": ["Custom versioning for mylar3"],
      "matchDatasources": ["docker"],
      "versioning": "regex:^version-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "matchPackageNames": ["/mylar3/"]
    },
    {
      "description": ["Process terraform files"],
      "matchManagers": ["terraform"],
      "matchDatasources": ["terraform-provider"],
      "versioning": "terraform",
      "matchPackagePatterns": [".*"]
    },
    {
      // These upstreams re-push the SAME release tag on every rebuild, so
      // Renovate opens a digest-only PR each time (llmkube-coder 0.9.19 has
      // been rebuilt 5+ times; posterizarr produced 26 digest PRs and
      // linuxserver/mariadb 7 in the last three months). We only want to move
      // when the version moves — the digest is still refreshed as part of the
      // x.y.z -> x.y.(z+1) bump, so the pins stay immutable either way.
      // Trade-off: base-image security rebuilds are picked up at the next
      // version bump instead of immediately.
      "description": ["Version-only updates for images with mutable release tags"],
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/misospace/llmkube-coder",
        "ghcr.io/fscorrupt/posterizarr",
        "ghcr.io/linuxserver/mariadb"
      ],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      // MinIO tags look like RELEASE.2025-09-07T16-13-09Z. Without this
      // Renovate cannot parse them as versions and the image never moves.
      // The -cpuv1 variants are excluded so we stay on the default build.
      "description": ["Date-based versioning for MinIO RELEASE.* tags"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/minio/minio"],
      "versioning": "regex:^RELEASE\\.(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})T(?<build>[\\d-]+)Z$"
    },
    {
      // umami publishes its Postgres image as postgresql-v2.18.1. The prefix
      // makes the tag unparseable as semver, so no update was ever offered.
      // The v became optional at 3.x (postgresql-3.0.0), so both forms are
      // matched here - expect a major PR for 3.x, which needs a DB migration.
      "description": ["Semver versioning behind umami's postgresql- tag prefix"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/umami-software/umami"],
      "versioning": "regex:^postgresql-v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      // amd-strix-halo-toolboxes tags the ROCm line as rocm-6.4.4 alongside
      // timestamped rebuilds (rocm-6.4.4_20260822T124902) and non-ROCm
      // variants. Match only the clean rocm-X.Y.Z form so we track the ROCm
      // version and ignore the nightly timestamp churn.
      "description": ["ROCm versioning for amd-strix-halo-toolboxes"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/kyuz0/amd-strix-halo-toolboxes"],
      "versioning": "regex:^rocm-(?<major>\\d+)\\.(?<minor>\\d+)(\\.(?<patch>\\d+))?$"
    },
    {
      // Hold Kubernetes < 1.36 until Talos 1.13 GAs — talosctl 1.12.x
      // refuses the 1.35 -> 1.36 upgrade path. Lift this rule in the same
      // PR that bumps ghcr.io/siderolabs/installer to v1.13.x.
      //
      // NOTE: talconfig.yaml is now on talosVersion v1.13.9, so that lift
      // condition has been met — this hold is stale. Lifting it starts a
      // 1.35 -> 1.36 cluster upgrade via tuppr, so it is left in place
      // deliberately until someone decides to run that upgrade.
      //
      // alpine/kubectl is held here too. It is only a client binary in
      // cronjobs, not a cluster component, but kubectl is supported only
      // within one minor of the API server — so left free it would reach
      // 1.37 while the cluster sits at 1.35 and quietly go out of skew.
      // Holding it here keeps every kubectl in the repo moving with the
      // cluster, in the single PR that lifts this rule.
      "description": ["Pin kubelet/kubectl to <1.36 (awaiting Talos 1.13 GA)"],
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/siderolabs/kubelet",
        "registry.k8s.io/kubectl",
        "docker.io/alpine/kubectl"
      ],
      "allowedVersions": "<1.36.0"
    },
    {
      // Pin rayproject/ray to exactly 2.54.0 to match the Ray version
      // baked into ghcr.io/ekenheim/grid-resilience-ray-worker:v1.0.18.
      // Ray enforces an EXACT head/worker version match — even a patch
      // bump (2.54.0 -> 2.54.1) breaks the cluster (workers stuck in
      // wait-gcs-ready). Bump this in the same PR that rebuilds the
      // worker image against the new Ray version.
      "description": ["Pin rayproject/ray to 2.54.0 (exact match with worker image)"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["rayproject/ray"],
      "allowedVersions": "<2.54.1"
    },
    {
      // Hold the dispatch chart at 0.5.40. 0.5.41's middleware tightened the
      // CSP to `script-src 'self'`, dropping 'unsafe-inline' without adding a
      // nonce. Next.js App Router streams its RSC payload through inline
      // `self.__next_f.push(...)` scripts, so browsers block every one of them
      // and the app never hydrates -- /automation sits on its "Loading..."
      // shell and the rest of the UI is inert. Lift together with the pin in
      // kubernetes/apps/datasci/dispatch/app/ocirepository.yaml once upstream
      // restores 'unsafe-inline' or emits a nonce.
      "description": ["Pin dispatch to 0.5.40 (0.5.41 CSP blocks hydration)"],
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/misospace/charts/dispatch",
        "ghcr.io/misospace/dispatch"
      ],
      "allowedVersions": "<0.5.41"
    }
  ]
}