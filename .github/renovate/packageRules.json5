{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      // Postgres sidecars that keep their data directory on the app's PVC.
      // A new major cannot open the old major's data directory, so a merged
      // major bump crash-loops the pod until someone runs pg_upgrade or a
      // dump/restore (Dispatcharr, #7713). Majors here are a manual job.
      "description": ["No major updates for Postgres sidecars with on-disk data"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/library/postgres", "docker.io/postgis/postgis"],
      "matchFileNames": [
        "kubernetes/apps/media/dispatcharr/**",
        "kubernetes/apps/default/dawarich/**"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": ["Semver versioning for nordic-housing images"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/ghcr.io\\/ekenheim\\/nordic-housing/"],
      "versioning": "semver"
    },
    {
      "description": ["Loose versioning for non-semver packages"],
      "matchDatasources": ["docker"],
      "versioning": "loose",
      "matchPackageNames": ["/plex/"]
    },
    {
      // llama.cpp tags every commit to master as server-b<N>, several a day.
      // Each bump rolls the `embeddings` pods that memini and hindsight depend
      // on, and PRs auto-merge here, so take one a month instead.
      "description": ["Build-number versioning and a monthly cadence for llama.cpp server images"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/ggml-org/llama.cpp"],
      "versioning": "regex:^server-b(?<major>\\d+)$",
      "schedule": ["on the first day of the month"]
    },
    {
      "description": ["Custom versioning for mylar3"],
      "matchDatasources": ["docker"],
      "versioning": "regex:^version-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "matchPackageNames": ["/mylar3/"]
    },
    {
      "description": ["Process terraform files"],
      "matchManagers": ["terraform"],
      "matchDatasources": ["terraform-provider"],
      "versioning": "terraform",
      "matchPackagePatterns": [".*"]
    },
    {
      // These upstreams re-push the SAME release tag on every rebuild, so
      // Renovate opens a digest-only PR each time (llmkube-coder 0.9.19 has
      // been rebuilt 5+ times; posterizarr produced 26 digest PRs and
      // linuxserver/mariadb 7 in the last three months). We only want to move
      // when the version moves — the digest is still refreshed as part of the
      // x.y.z -> x.y.(z+1) bump, so the pins stay immutable either way.
      // Trade-off: base-image security rebuilds are picked up at the next
      // version bump instead of immediately.
      "description": ["Version-only updates for images with mutable release tags"],
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/misospace/llmkube-coder",
        // Same publisher, same behaviour: 0.7.3 was re-pushed, producing a
        // digest-only PR (#6557, 653df5b -> 0c753ec) with no version change.
        // Listed explicitly rather than matching the ghcr.io/misospace/ prefix
        // because the only other package from that org is `charts`, an OCI Helm
        // chart that moves by version and does not need this.
        "ghcr.io/fscorrupt/posterizarr",
        "ghcr.io/linuxserver/mariadb",
        // docker.io/library/python is here for a slightly different reason:
        // the Docker official images re-push the *patch* tag on every Debian
        // base rebuild, so pinning tighter does not help. Verified 2026-08-27:
        // 3.14.7-slim was rebuilt that day (83ff1d24 -> cae66f2) while
        // 3.14.6-slim had not moved since Aug 5, i.e. both 3.14-slim and
        // 3.14.7-slim are mutable. Version-only is the only way to stop the
        // churn. Note the trade-off bites harder here than above: for a base
        // image the digest bump IS the CPython/Debian security rebuild, so
        // platform-mcp now holds today's build until the tag moves to
        // 3.15-slim. Acceptable because that server is pure stdlib over stdio
        // with readOnlyRootFilesystem, uid 1000 and no egress -- revisit if it
        // ever grows dependencies or a network path.
        "docker.io/library/python"
      ],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      // SearXNG tags every commit as <year>.<month>.<day>-<short sha>, several
      // a day. Renovate's docker versioning treats the "-<sha>" as a
      // compatibility suffix and only offers updates that share it, so no
      // update was EVER offered (the image sat on 2025.5.17 for 16 months).
      // Read the date as major.minor.patch and the sha as build metadata, and
      // take one bump a month since PRs auto-merge here.
      "description": ["Date-plus-sha versioning and a monthly cadence for searxng rolling tags"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/searxng/searxng"],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,2})-(?<build>[0-9a-f]+)$",
      "schedule": ["on the first day of the month"]
    },
    {
      // MinIO tags look like RELEASE.2025-09-07T16-13-09Z. Without this
      // Renovate cannot parse them as versions and the image never moves.
      // The -cpuv1 variants are excluded so we stay on the default build.
      // MinIO pulled its images from quay.io and Docker Hub (both 401 since
      // 2026-09). pgsty/silo, the maintained community fork (formerly
      // pgsty/minio), keeps the tag scheme; the same anchors exclude its
      // -distroless and per-arch (-amd64/-arm64) tags.
      "description": ["Date-based versioning for MinIO RELEASE.* tags"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/minio/minio", "docker.io/pgsty/silo"],
      "versioning": "regex:^RELEASE\\.(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})T(?<build>[\\d-]+)Z$"
    },
    {
      // umami publishes its Postgres image as postgresql-v2.18.1. The prefix
      // makes the tag unparseable as semver, so no update was ever offered.
      // The v became optional at 3.x (postgresql-3.0.0), so both forms are
      // matched here - expect a major PR for 3.x, which needs a DB migration.
      "description": ["Semver versioning behind umami's postgresql- tag prefix"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/umami-software/umami"],
      "versioning": "regex:^postgresql-v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      // amd-strix-halo-toolboxes tags the ROCm line as rocm-6.4.4 alongside
      // timestamped rebuilds (rocm-6.4.4_20260822T124902) and non-ROCm
      // variants. Match only the clean rocm-X.Y.Z form so we track the ROCm
      // version and ignore the nightly timestamp churn.
      "description": ["ROCm versioning for amd-strix-halo-toolboxes"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/kyuz0/amd-strix-halo-toolboxes"],
      "versioning": "regex:^rocm-(?<major>\\d+)\\.(?<minor>\\d+)(\\.(?<patch>\\d+))?$"
    },
    {
      // text-embeddings-inference tags its CPU build cpu-1.8.3. Docker
      // versioning finds no version in that (the lookup on 2026-10-19 had no
      // currentVersion), so nothing was ever offered while upstream reached
      // cpu-1.9.4. The anchors skip the floating cpu-1.9, the -grpc variants
      // and the per-commit cpu-sha-<sha> tags. Patch and minor automerge.
      "description": ["Prefix-aware versioning for text-embeddings-inference CPU tags"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/huggingface/text-embeddings-inference"],
      "versioning": "regex:^cpu-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      // Same <date>-<sha> scheme as searxng above (2024.10.22-7ca5933): docker
      // versioning reads the sha as a compatibility suffix and offers nothing
      // with a different sha, so it-tools sat on 2023.12.21 for ten months.
      // A separate rule because upstream releases a few times a year, so it
      // needs no monthly cadence. A new year is a major and waits for a hand
      // merge; within a year it automerges.
      "description": ["Date-plus-sha versioning for it-tools"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/corentinth/it-tools"],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,2})-(?<build>[0-9a-f]+)$"
    },
    {
      // postgis tags are <PG major>-<PostGIS x.y>[-alpine]. Docker versioning
      // reads 17 as the version and -3.5-alpine as a suffix, so 17-3.6-alpine
      // never showed. Here the PG major is the major (still disabled for
      // dawarich by the sidecar rule at the top of this file) and a PostGIS
      // release is minor.patch. The anchors skip 17-3.6.0alpha1-alpine and
      // 18-3.7.0rc2-alpine; -alpine must match the current tag. No automerge:
      // a PostGIS bump needs `ALTER EXTENSION postgis UPDATE;` in the database
      // afterwards.
      "description": ["PG-major + PostGIS versioning for postgis images, never automerged"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/postgis/postgis"],
      "versioning": "regex:^(?<major>\\d+)-(?<minor>\\d+)\\.(?<patch>\\d+)(?<compatibility>-alpine)?$",
      "automerge": false
    },
    {
      // HOLD on PostGIS 3.5 for dawarich (2026-10-19). The 17-3.6-alpine image
      // (PostGIS 3.6.4) has no upgrade path from our 3.5.7: it ships
      // postgis--3.5.0..3.5.5--3.6.4 and ANY--3.6.4 but no 3.5.7--ANY, because
      // 3.6.4 was built before 3.5.7 existed. ALTER EXTENSION and
      // postgis_extensions_upgrade() both fail, so #7781 was reverted. Lift the
      // hold once a 3.6 image has the script:
      //   ls $(pg_config --sharedir)/extension | grep 'postgis--3.5.7--'
      // Matched on the tag itself: a "<17.3.6" range didn't stop Renovate from
      // reopening 17-3.6-alpine (#7791) under the regex versioning above.
      "description": ["Hold postgis on 3.5 until 3.6 ships an upgrade path from 3.5.7"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/postgis/postgis"],
      "matchFileNames": ["kubernetes/apps/default/dawarich/**"],
      "allowedVersions": "/^17-3\\.5(-alpine)?$/"
    },
    {
      // gpu-jupyter tags look like v1.9_cuda-12.6_ubuntu-24.04_python-only and
      // did not parse at all (v1.10 and v1.11 were never offered). Release
      // number is major.minor, the CUDA version patch.build: one release has
      // shipped several CUDA builds (v1.5 with 11.6, 11.8 and 12.0), and this
      // picks the newest. Only the python-only flavour. Never automerged: a
      // new CUDA (v1.11 is cuda-13.0) has to be supported by the host driver.
      // The HelmRelease writes the short name, so both forms are listed.
      "description": ["gpu-jupyter release versioning, never automerged"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["cschranz/gpu-jupyter", "docker.io/cschranz/gpu-jupyter"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)_cuda-(?<patch>\\d+)\\.(?<build>\\d+)_ubuntu-[\\d.]+_python-only$",
      "automerge": false
    },
    {
      // Langflow is a Python package and tags its images with PEP 440
      // versions: 1.5.0.post1, 1.13.0.dev43, 1.13.0rc0. Docker versioning
      // rejects .postN (skipReason invalid-value on 2026-10-19), which froze
      // langflow at 1.5.0.post1. pep440 parses all of them, treats .devN and
      // rcN as unstable (skipped), and ignores the -amd64/-arm64 per-arch
      // tags. The HelmRelease writes the short name, so both forms are listed.
      // Never automerged: every minor runs Alembic migrations on the Postgres
      // database at startup (Langflow's docs say pg_dump first), and minors
      // change auth defaults (1.11 images turn auto-login off, 1.12 makes the
      // MCP endpoints require an API key).
      "description": ["PEP 440 versioning for langflow images, never automerged"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["langflowai/langflow", "docker.io/langflowai/langflow"],
      "versioning": "pep440",
      "automerge": false
    },
    {
      // Hold Kubernetes < 1.36 until Talos 1.13 GAs — talosctl 1.12.x
      // refuses the 1.35 -> 1.36 upgrade path. Lift this rule in the same
      // PR that bumps the Talos installer to v1.13.x (tracked as
      // ghcr.io/siderolabs/installer-base since 2026-10-19).
      //
      // NOTE: talconfig.yaml is now on talosVersion v1.13.9, so that lift
      // condition has been met — this hold is stale. Lifting it starts a
      // 1.35 -> 1.36 cluster upgrade via tuppr, so it is left in place
      // deliberately until someone decides to run that upgrade.
      //
      // alpine/kubectl is held here too. It is only a client binary in
      // cronjobs, not a cluster component, but kubectl is supported only
      // within one minor of the API server — so left free it would reach
      // 1.37 while the cluster sits at 1.35 and quietly go out of skew.
      // Holding it here keeps every kubectl in the repo moving with the
      // cluster, in the single PR that lifts this rule.
      "description": ["Pin kubelet/kubectl to <1.36 (awaiting Talos 1.13 GA)"],
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/siderolabs/kubelet",
        "registry.k8s.io/kubectl",
        "docker.io/alpine/kubectl"
      ],
      "allowedVersions": "<1.36.0"
    },
    // The kuberay-operator chart 1.7.1 skip was removed on 2026-10-19. The
    // chart's default image quay.io/kuberay/operator:v1.7.1 was missing when
    // the rule went in (2026-09-19), so every upgrade ImagePullBackOff'd and
    // rolled back. Upstream pushed it with the v1.7.1 release (2026-09-21;
    // quay digest e69b9cde on 2026-10-19), so 1.7.1 is proposed again.
    {
      // 0.9.28 (defilantech/LLMKube#1829) passes spec.args verbatim whenever
      // spec.command is set, dropping the runtime-built args. Our llama.cpp
      // InferenceServices need `command: [llama-server]` (the Strix Halo
      // toolbox image has no entrypoint) and set no spec.args, so ornith came
      // up serving nothing. See kubernetes/apps/llm/llmkube/app/helmrelease.yaml.
      "description": ["Hold llmkube chart below 0.9.28 until the InferenceServices carry their own spec.args"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/defilantech/charts/llmkube"],
      "allowedVersions": "<0.9.28"
    },
    {
      // Hermes Agent switched from CalVer to SemVer. Its tags ran
      // v2026.7.1 ... v2026.9.24 (each one really 0.18.0 ... 0.21.5), then
      // v0.21.6 on 2026-10-08 began plain SemVer. Renovate compares the two
      // schemes numerically, so it ranked v2026.9.24 above every v0.x and
      // offered nothing from 2026-09-24 until hermes was bumped to v0.22.2 by
      // hand on 2026-10-19. This keeps the old CalVer tags (any four-digit
      // first component) from ever being proposed again as "newer" than the
      // pinned 0.x. Same negated-regex form as the kuberay rule above.
      // Docker Hub also carries rc.N-vX.Y.Z and -desktop / -amd64 tags;
      // docker versioning already skips those (not a version, or a
      // different suffix from the pinned tag).
      //
      // Also never automerged (owner decision, 2026-10-19), digests included.
      // The init container runs this image's python3 and hermes CLI directly
      // (merge-config.py, the memini plugin install), so it depends on image
      // internals no changelog promises. v0.22.0 dropped PyYAML from the venv,
      // and the old `import yaml` would have crash-looped the init container
      // had that bump auto-merged (fixed in #7771). Under SemVer 0.x a
      // 0.22 -> 0.23 bump is a "minor", which autoMergeApps.json5 would
      // otherwise merge. This file loads after the automerge files, so this
      // wins.
      "description": ["Never propose hermes-agent's retired CalVer tags (v2026.x); never automerge it"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/nousresearch/hermes-agent"],
      "allowedVersions": "!/^v?\\d{4}\\./",
      "automerge": false
    },
    {
      // A rolling tag (latest, rocm7, vulkan-radv, 24-alpine, 18) with no
      // digest never updates: the pull policy defaults to IfNotPresent, so a
      // node keeps whichever build it cached first, and nothing in Git says
      // which one that is. Nobody remembers which apps are in that state, so
      // Renovate pins a digest on every such tag itself - including on apps
      // added later - and autoMergeDocker.json5 merges the digest bumps
      // weekly. Tags with a real version (1.2.3) are left as they are: a
      // version bump already moves them.
      // The pattern is "a bare word" or "a major only, with an optional
      // flavour". Our own CI images are excluded: their workflows rewrite the
      // tag to a commit SHA, and a stale digest left behind it would not pull.
      "description": ["Pin digests on rolling tags so they update through Renovate"],
      "matchDatasources": ["docker"],
      "matchCurrentValue": "/^([a-z][a-z0-9_-]*|\\d+(-[a-z0-9_-]+)?)$/",
      "matchPackageNames": ["!/ekenheim/", "!/nordic-housing/"],
      "pinDigests": true
    },
    {
      // rocm-10.0 looks like a version to the rule above but is a rolling
      // tag too, rebuilt about four times a day. The ROCm versioning rule
      // earlier in this file still offers the next ROCm line as a major.
      "description": ["Pin digests on amd-strix-halo-toolboxes ROCm tags"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/kyuz0/amd-strix-halo-toolboxes"],
      "pinDigests": true
    },
    {
      // The rolling-tag rule above would pin `feature:2` to
      // `feature:2@sha256:...`, which the devcontainer CLI rejects ("failed
      // validation", @devcontainers/cli 0.89.0 on 2026-10-17): the container
      // could not be built at all. Some features also ship a zero-byte OCI
      // config blob that Renovate cannot read a pinned digest from (ZodError,
      // renovate 44.132.6 on 2026-10-04). Features are fetched when the
      // devcontainer is built, so the floating major tag is enough. The base
      // image (depType "image") keeps its digest.
      "description": ["Do not pin digests on devcontainer features"],
      "matchManagers": ["devcontainer"],
      "matchDepTypes": ["feature"],
      "pinDigests": false
    },
    {
      // Kavita runs one-way DB migrations on start in nearly every release
      // (0.8.0 rewrote chapters and exported progress; 0.8.4 dropped people
      // metadata until a forced scan; 0.9.1 reworked scrobbling and OAuth).
      // The old image cannot open a migrated kavita.db, so each bump needs a
      // fresh VolSync snapshot first and is merged by hand. Without this rule
      // autoMergeApps.json5 would merge 0.9.1 -> 0.9.2 as a patch.
      "description": ["Never automerge Kavita (one-way DB migrations)"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/kareadita/kavita"],
      "automerge": false
    },
    // The dispatch hold at <0.5.41 was removed here on 2026-08-29. It existed
    // because 0.5.41 tightened the CSP to `script-src 'self'` without a nonce,
    // which blocked Next.js's inline RSC bootstrap and left the UI unhydrated.
    // misospace/dispatch#845 added a per-request nonce and shipped in v0.5.42;
    // kubernetes/apps/llm/dispatch/app/ocirepository.yaml now tracks 0.5.48.
    // Renovate is free to move this package again.
    {
      // Atlas (github.com/ekenheim/atlas). Every Atlas release is a deploy the
      // owner merges by hand, never automatically. This covers every update
      // type in that directory, digests included: autoMergeDocker.json5's
      // weekly and "/ekenheim/" digest merges and autoMergeApps.json5's
      // minor/patch merge all come earlier and are overridden here. Keep these
      // two rules LAST, so nothing later re-enables automerge.
      "description": ["Never automerge anything under kubernetes/apps/development/atlas (Atlas)"],
      "matchFileNames": ["kubernetes/apps/development/atlas/**"],
      "automerge": false
    },
    {
      // The Atlas image anywhere else it might be referenced (a Job, a
      // second release). The path rule above already covers development/atlas.
      "description": ["Never automerge ghcr.io/ekenheim/atlas"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/ekenheim/atlas"],
      "automerge": false
    }
  ]
}